+// adminHasChosen reports whether a setting was written by an administrator, as
+// opposed to filled in from the default declared in plugin.json. Keys are
+// lower cased in the stored configuration.
+func (p *Plugin) adminHasChosen(key string) bool {
+	cfg := p.API.GetConfig()
+	if cfg == nil {
+		return false
+	}
+
+	stored, ok := cfg.PluginSettings.Plugins[manifest.Id]
+	if !ok {
+		return false
+	}
+
+	_, ok = stored[key]
+
+	return ok
+}
