+// transcriptPosted reports whether the transcript for the given recording has
+// already been posted to the call thread.
+func transcriptPosted(callPost *model.Post, recID string) bool {
+	transcriptions, ok := callPost.GetProp("transcriptions").(map[string]any)
+	if !ok {
+		return false
+	}
+	for _, v := range transcriptions {
+		var tm jobMetadata
+		tm.fromMap(v)
+		if tm.RecID == recID && tm.PostID != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// removeRecordingPost deletes a recording post, and with it the file attached
+// to it, for the keep-only-the-transcript setting. A failure is logged and
+// otherwise ignored: keeping a recording we meant to drop is the safe side.
+func (p *Plugin) removeRecordingPost(postID, recID string) {
+	if appErr := p.API.DeletePost(postID); appErr != nil {
+		p.LogError("failed to remove recording post", "recID", recID, "postID", postID, "err", appErr.Error())
+	}
+}
