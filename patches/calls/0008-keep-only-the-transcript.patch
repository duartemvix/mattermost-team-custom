diff --git a/server/keep_transcript_only_test.go b/server/keep_transcript_only_test.go
new file mode 100644
index 0000000..f021651
--- /dev/null
+++ b/server/keep_transcript_only_test.go
@@ -0,0 +1,56 @@
+// Copyright (c) 2020-present Mattermost, Inc. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+package main
+
+import (
+	"testing"
+
+	"github.com/mattermost/mattermost/server/public/model"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestKeepTranscriptOnly(t *testing.T) {
+	t.Run("off by default", func(t *testing.T) {
+		var cfg configuration
+		cfg.SetDefaults()
+		require.False(t, cfg.keepTranscriptOnly())
+	})
+
+	t.Run("needs transcriptions", func(t *testing.T) {
+		var cfg configuration
+		cfg.SetDefaults()
+		cfg.KeepTranscriptOnly = model.NewPointer(true)
+		require.False(t, cfg.keepTranscriptOnly())
+
+		cfg.EnableRecordings = model.NewPointer(true)
+		require.False(t, cfg.keepTranscriptOnly())
+
+		cfg.EnableTranscriptions = model.NewPointer(true)
+		require.True(t, cfg.keepTranscriptOnly())
+	})
+
+	t.Run("survives a clone", func(t *testing.T) {
+		var cfg configuration
+		cfg.SetDefaults()
+		cfg.KeepTranscriptOnly = model.NewPointer(true)
+		require.True(t, *cfg.Clone().KeepTranscriptOnly)
+	})
+}
+
+func TestTranscriptPosted(t *testing.T) {
+	post := &model.Post{}
+	require.False(t, transcriptPosted(post, "rec1"))
+
+	post.AddProp("transcriptions", map[string]any{
+		"tr1": (&jobMetadata{RecID: "rec1"}).toMap(),
+	})
+	require.False(t, transcriptPosted(post, "rec1"), "transcript job exists but nothing is posted yet")
+
+	post.AddProp("transcriptions", map[string]any{
+		"tr1": (&jobMetadata{RecID: "rec1", PostID: "p1"}).toMap(),
+	})
+	require.True(t, transcriptPosted(post, "rec1"))
+	require.False(t, transcriptPosted(post, "other"))
+}
