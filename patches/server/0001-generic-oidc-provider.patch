+		{"illegal characters replaced", OpenIDUser{Subject: "1", Email: "jane+tag(x)@example.com"}, nil, "jane-tag-x"},
+		{"uppercase folded", OpenIDUser{Subject: "1", Email: "JANE@example.com"}, nil, "jane"},
