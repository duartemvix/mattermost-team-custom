+func TestGetSSOSettings(t *testing.T) {
+	rctx := request.TestContext(t)
+
+	newConfig := func() *model.Config {
+		cfg := &model.Config{}
+		cfg.SetDefaults()
+		return cfg
+	}
+
+	fill := func(s *model.SSOSettings) {
+		s.Enable = model.NewPointer(true)
+		s.Id = model.NewPointer("client-id")
+		s.Secret = model.NewPointer("client-secret")
+		s.AuthEndpoint = model.NewPointer("https://idp.example.com/auth")
+		s.TokenEndpoint = model.NewPointer("https://idp.example.com/token")
+		s.UserAPIEndpoint = model.NewPointer("https://idp.example.com/userinfo")
+	}
+
+	t.Run("openid maps to OpenIdSettings", func(t *testing.T) {
+		cfg := newConfig()
+		fill(&cfg.OpenIdSettings)
+
+		settings, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, "https://idp.example.com/auth", *settings.AuthEndpoint)
+	})
+
+	t.Run("gitlab maps to GitLabSettings", func(t *testing.T) {
+		cfg := newConfig()
+		fill(&cfg.GitLabSettings)
+		cfg.GitLabSettings.AuthEndpoint = model.NewPointer("https://gitlab.example.com/oauth/authorize")
+
+		settings, err := New().GetSSOSettings(rctx, cfg, model.ServiceGitlab)
+		require.NoError(t, err)
+		assert.Equal(t, "https://gitlab.example.com/oauth/authorize", *settings.AuthEndpoint)
+	})
+
+	t.Run("google maps to GoogleSettings", func(t *testing.T) {
+		// App.getSSOProvider routes google here as soon as an administrator puts
+		// "openid" in its scope, so it has to be handled or those logins break.
+		cfg := newConfig()
+		cfg.GoogleSettings.Enable = model.NewPointer(true)
+		cfg.GoogleSettings.Id = model.NewPointer("client-id")
+		cfg.GoogleSettings.Secret = model.NewPointer("client-secret")
+		cfg.GoogleSettings.Scope = model.NewPointer("profile email openid")
+
+		settings, err := New().GetSSOSettings(rctx, cfg, model.ServiceGoogle)
+		require.NoError(t, err)
+		assert.Equal(t, *cfg.GoogleSettings.AuthEndpoint, *settings.AuthEndpoint)
+		assert.Equal(t, *cfg.GoogleSettings.UserAPIEndpoint, *settings.UserAPIEndpoint)
+	})
+
+	t.Run("office365 maps to Office365Settings", func(t *testing.T) {
+		cfg := newConfig()
+		cfg.Office365Settings.Enable = model.NewPointer(true)
+		cfg.Office365Settings.Id = model.NewPointer("client-id")
+		cfg.Office365Settings.Secret = model.NewPointer("client-secret")
+		cfg.Office365Settings.AuthEndpoint = model.NewPointer("https://login.microsoftonline.com/common/oauth2/v2.0/authorize")
+		cfg.Office365Settings.TokenEndpoint = model.NewPointer("https://login.microsoftonline.com/common/oauth2/v2.0/token")
+		cfg.Office365Settings.UserAPIEndpoint = model.NewPointer("https://graph.microsoft.com/v1.0/me")
+
+		settings, err := New().GetSSOSettings(rctx, cfg, model.ServiceOffice365)
+		require.NoError(t, err)
+		assert.Equal(t, "https://graph.microsoft.com/v1.0/me", *settings.UserAPIEndpoint)
+	})
+
+	t.Run("unknown service", func(t *testing.T) {
+		_, err := New().GetSSOSettings(rctx, newConfig(), model.UserAuthServiceSaml)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "not handled")
+	})
+
+	t.Run("disabled service", func(t *testing.T) {
+		cfg := newConfig()
+		fill(&cfg.OpenIdSettings)
+		cfg.OpenIdSettings.Enable = model.NewPointer(false)
+
+		_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "not enabled")
+	})
+
+	t.Run("misconfigured service", func(t *testing.T) {
+		cfg := newConfig()
+		fill(&cfg.OpenIdSettings)
+		cfg.OpenIdSettings.Secret = model.NewPointer("")
+		cfg.OpenIdSettings.TokenEndpoint = model.NewPointer("")
+
+		_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "Secret")
+		assert.Contains(t, err.Error(), "TokenEndpoint")
+	})
+
+	t.Run("configured endpoints must use https", func(t *testing.T) {
+		for _, tc := range []struct {
+			name string
+			set  func(*model.SSOSettings)
+		}{
+			{"AuthEndpoint", func(s *model.SSOSettings) { s.AuthEndpoint = model.NewPointer("http://idp.example.com/auth") }},
+			{"TokenEndpoint", func(s *model.SSOSettings) { s.TokenEndpoint = model.NewPointer("http://idp.example.com/token") }},
+			{"UserAPIEndpoint", func(s *model.SSOSettings) { s.UserAPIEndpoint = model.NewPointer("http://idp.example.com/userinfo") }},
+		} {
+			t.Run(tc.name, func(t *testing.T) {
+				cfg := newConfig()
+				fill(&cfg.OpenIdSettings)
+				tc.set(&cfg.OpenIdSettings)
+
+				_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), tc.name)
+				assert.Contains(t, err.Error(), "https")
+			})
+		}
+	})
+
+	t.Run("an http discovery endpoint is refused", func(t *testing.T) {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			t.Error("a plain http discovery endpoint must never be contacted")
+			w.WriteHeader(http.StatusInternalServerError)
+		}))
+		defer server.Close()
+
+		cfg := newConfig()
+		cfg.ServiceSettings.AllowedUntrustedInternalConnections = model.NewPointer(allowlistFor(server))
+		cfg.OpenIdSettings.Enable = model.NewPointer(true)
+		cfg.OpenIdSettings.Id = model.NewPointer("client-id")
+		cfg.OpenIdSettings.Secret = model.NewPointer("client-secret")
+		cfg.OpenIdSettings.DiscoveryEndpoint = model.NewPointer(server.URL)
+
+		_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "https")
+	})
+
+	t.Run("endpoints are filled from discovery and the config is not mutated", func(t *testing.T) {
+		var hits int
+		var server *httptest.Server
+		server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			hits++
+			assert.Equal(t, wellKnownPath, r.URL.Path)
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(discoveryBody(server.URL)))
+		}))
+		defer server.Close()
+
+		cfg := testConfig(server)
+		cfg.OpenIdSettings.Enable = model.NewPointer(true)
+		cfg.OpenIdSettings.Id = model.NewPointer("client-id")
+		cfg.OpenIdSettings.Secret = model.NewPointer("client-secret")
+		cfg.OpenIdSettings.DiscoveryEndpoint = model.NewPointer(server.URL)
+
+		provider := New()
+		settings, err := provider.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, server.URL+"/auth", *settings.AuthEndpoint)
+		assert.Equal(t, server.URL+"/token", *settings.TokenEndpoint)
+		assert.Equal(t, server.URL+"/userinfo", *settings.UserAPIEndpoint)
+		assert.Empty(t, *cfg.OpenIdSettings.AuthEndpoint, "the server configuration must not be mutated")
+
+		// A second call is served from the cache.
+		_, err = provider.GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, 1, hits)
+	})
+
+	t.Run("discovery goes through the guarded transport", func(t *testing.T) {
+		var server *httptest.Server
+		server = httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			t.Error("the discovery endpoint must not be reachable without an allowlist entry")
+			_, _ = w.Write([]byte(discoveryBody(server.URL)))
+		}))
+		defer server.Close()
+
+		// The server listens on a loopback address and the allowlist is empty,
+		// so AllowedUntrustedInternalConnections must block the request.
+		cfg := newConfig()
+		cfg.OpenIdSettings.Enable = model.NewPointer(true)
+		cfg.OpenIdSettings.Id = model.NewPointer("client-id")
+		cfg.OpenIdSettings.Secret = model.NewPointer("client-secret")
+		cfg.OpenIdSettings.DiscoveryEndpoint = model.NewPointer(server.URL)
+
+		_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "AllowedUntrustedInternalConnections")
+	})
+
+	t.Run("configured endpoints win over discovery", func(t *testing.T) {
+		server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			t.Error("discovery must not be fetched when every endpoint is configured")
+			w.WriteHeader(http.StatusInternalServerError)
+		}))
+		defer server.Close()
+
+		cfg := testConfig(server)
+		fill(&cfg.OpenIdSettings)
+		cfg.OpenIdSettings.DiscoveryEndpoint = model.NewPointer(server.URL)
+
+		settings, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.NoError(t, err)
+		assert.Equal(t, "https://idp.example.com/token", *settings.TokenEndpoint)
+	})
+
+	t.Run("discovery failure is reported", func(t *testing.T) {
+		server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+			w.WriteHeader(http.StatusNotFound)
+		}))
+		defer server.Close()
+
+		cfg := testConfig(server)
+		cfg.OpenIdSettings.Enable = model.NewPointer(true)
+		cfg.OpenIdSettings.Id = model.NewPointer("client-id")
+		cfg.OpenIdSettings.Secret = model.NewPointer("client-secret")
+		cfg.OpenIdSettings.DiscoveryEndpoint = model.NewPointer(server.URL)
+
+		_, err := New().GetSSOSettings(rctx, cfg, model.ServiceOpenid)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "404")
+	})
+}
