+func TestEmailVerifiedClaim(t *testing.T) {
+	rctx := request.TestContext(t)
+	provider := New()
+
+	t.Run("accepted", func(t *testing.T) {
+		for _, claim := range []string{`true`, `"true"`, `"TRUE"`, `"True"`, `"t"`, `1`, `"1"`} {
+			t.Run(claim, func(t *testing.T) {
+				user, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"1","email":"a@b.com","email_verified":`+claim+`}`), nil, nil)
+				require.NoError(t, err)
+				assert.Equal(t, "a@b.com", user.Email)
+			})
+		}
+	})
+
+	t.Run("rejected", func(t *testing.T) {
+		// Every one of these is the provider saying the address is not verified.
+		for _, claim := range []string{`false`, `"false"`, `"FALSE"`, `"False"`, `"f"`, `0`, `"0"`} {
+			t.Run(claim, func(t *testing.T) {
+				_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"1","email":"a@b.com","email_verified":`+claim+`}`), nil, nil)
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "unverified")
+			})
+		}
+	})
+
+	t.Run("an unreadable claim is rejected", func(t *testing.T) {
+		for _, claim := range []string{`"maybe"`, `""`, `{}`, `[]`} {
+			t.Run(claim, func(t *testing.T) {
+				_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"1","email":"a@b.com","email_verified":`+claim+`}`), nil, nil)
+				require.Error(t, err)
+				assert.Contains(t, err.Error(), "email_verified")
+			})
+		}
+	})
+
+	t.Run("an absent claim does not block the login", func(t *testing.T) {
+		for _, body := range []string{`{"sub":"1","email":"a@b.com"}`, `{"sub":"1","email":"a@b.com","email_verified":null}`} {
+			user, err := provider.GetUserFromJSON(rctx, strings.NewReader(body), nil, nil)
+			require.NoError(t, err)
+			assert.Equal(t, "a@b.com", user.Email)
+		}
+	})
+}
