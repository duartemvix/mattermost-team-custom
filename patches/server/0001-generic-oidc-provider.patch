+func TestSubjectClaim(t *testing.T) {
+	rctx := request.TestContext(t)
+	provider := New()
+
+	t.Run("accepted", func(t *testing.T) {
+		for _, tc := range []struct{ name, sub, expected string }{
+			{"string", `"abc-123"`, "abc-123"},
+			{"number", `12345`, "12345"},
+			{"large number keeps its digits", `123456789012345678901234567890`, "123456789012345678901234567890"},
+			{"surrounding whitespace is trimmed", `"  abc  "`, "abc"},
+		} {
+			t.Run(tc.name, func(t *testing.T) {
+				user, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":`+tc.sub+`,"email":"a@b.com"}`), nil, nil)
+				require.NoError(t, err)
+				assert.Equal(t, tc.expected, *user.AuthData)
+			})
+		}
+	})
+
+	t.Run("rejected", func(t *testing.T) {
+		// Anything but a string or a number would otherwise land in AuthData as
+		// raw JSON and become the identity of the account.
+		for _, tc := range []struct{ name, sub string }{
+			{"object", `{"id":"abc"}`},
+			{"array", `["abc"]`},
+			{"boolean", `true`},
+			{"whitespace only string", `"   "`},
+		} {
+			t.Run(tc.name, func(t *testing.T) {
+				_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":`+tc.sub+`,"email":"a@b.com"}`), nil, nil)
+				require.Error(t, err)
+			})
+		}
+	})
+}
