+func TestIsSameUser(t *testing.T) {
+	rctx := request.TestContext(t)
+	provider := New()
+
+	oidcUser := func(authData string) *model.User {
+		return &model.User{AuthData: model.NewPointer(authData), AuthService: model.ServiceOpenid}
+	}
+
+	t.Run("the same subject of the same service", func(t *testing.T) {
+		assert.True(t, provider.IsSameUser(rctx, oidcUser("a"), oidcUser("a")))
+	})
+
+	t.Run("a different subject", func(t *testing.T) {
+		assert.False(t, provider.IsSameUser(rctx, oidcUser("a"), oidcUser("b")))
+	})
+
+	t.Run("an account of another auth service is never the same user", func(t *testing.T) {
+		// App.CreateOAuthUser uses this to decide whether an existing account
+		// found by email may be converted to the incoming SSO identity. An LDAP
+		// or SAML account whose AuthData happens to equal an OpenID Connect
+		// subject must not be taken over.
+		for _, service := range []string{
+			model.UserAuthServiceLdap,
+			model.UserAuthServiceSaml,
+			model.ServiceGitlab,
+			model.ServiceGoogle,
+			"",
+		} {
+			dbUser := &model.User{AuthData: model.NewPointer("a"), AuthService: service}
+			assert.False(t, provider.IsSameUser(rctx, dbUser, oidcUser("a")), "service %q", service)
+		}
+	})
+
+	t.Run("empty auth data", func(t *testing.T) {
+		assert.False(t, provider.IsSameUser(rctx, oidcUser(""), oidcUser("")))
+		assert.False(t, provider.IsSameUser(rctx, oidcUser("a"), oidcUser("")))
+	})
+
+	t.Run("missing users or auth data", func(t *testing.T) {
+		assert.False(t, provider.IsSameUser(rctx, &model.User{AuthService: model.ServiceOpenid}, oidcUser("a")))
+		assert.False(t, provider.IsSameUser(rctx, nil, oidcUser("a")))
+		assert.False(t, provider.IsSameUser(rctx, oidcUser("a"), nil))
+	})
+}
