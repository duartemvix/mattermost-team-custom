+func TestGetUserFromJSON(t *testing.T) {
+	rctx := request.TestContext(t)
+	provider := New()
+
+	t.Run("standard claims", func(t *testing.T) {
+		body := `{
+			"sub": "abc-123",
+			"email": "Jane.Doe@Example.COM",
+			"email_verified": true,
+			"preferred_username": "jdoe",
+			"name": "Jane Doe",
+			"given_name": "Jane",
+			"family_name": "Doe",
+			"nickname": "janey"
+		}`
+
+		user, err := provider.GetUserFromJSON(rctx, strings.NewReader(body), nil, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "abc-123", *user.AuthData)
+		assert.Equal(t, "jane.doe@example.com", user.Email)
+		assert.Equal(t, "Jane", user.FirstName)
+		assert.Equal(t, "Doe", user.LastName)
+		assert.Equal(t, "janey", user.Nickname)
+		// UsePreferredUsername is off, so the local part of the email wins.
+		assert.Equal(t, "jane.doe", user.Username)
+		assert.Empty(t, user.AuthService, "the caller fills in the service")
+	})
+
+	t.Run("preferred username honoured when enabled", func(t *testing.T) {
+		body := `{"sub":"1","email":"jane.doe@example.com","preferred_username":"jdoe@example.com"}`
+		settings := &model.SSOSettings{UsePreferredUsername: model.NewPointer(true)}
+
+		user, err := provider.GetUserFromJSON(rctx, strings.NewReader(body), nil, settings)
+		require.NoError(t, err)
+		assert.Equal(t, "jdoe", user.Username)
+	})
+
+	t.Run("name split when discrete claims are missing", func(t *testing.T) {
+		body := `{"sub":"1","email":"a@b.com","name":"Jan van der Berg"}`
+
+		user, err := provider.GetUserFromJSON(rctx, strings.NewReader(body), nil, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "Jan", user.FirstName)
+		assert.Equal(t, "van der Berg", user.LastName)
+	})
+
+	t.Run("single word name", func(t *testing.T) {
+		body := `{"sub":"1","email":"a@b.com","name":"Prince"}`
+
+		user, err := provider.GetUserFromJSON(rctx, strings.NewReader(body), nil, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "Prince", user.FirstName)
+		assert.Empty(t, user.LastName)
+	})
+
+	t.Run("missing sub is rejected", func(t *testing.T) {
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"email":"a@b.com"}`), nil, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "sub")
+	})
+
+	t.Run("missing email is rejected", func(t *testing.T) {
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"1"}`), nil, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "email")
+	})
+
+	t.Run("invalid json is rejected", func(t *testing.T) {
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`not json`), nil, nil)
+		require.Error(t, err)
+	})
+
+	t.Run("id token subject must match the userinfo subject", func(t *testing.T) {
+		tokenUser := &model.User{AuthData: model.NewPointer("someone-else")}
+
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc","email":"a@b.com"}`), tokenUser, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "does not match")
+	})
+
+	t.Run("the id token only fills in cosmetic claims", func(t *testing.T) {
+		tokenUser := &model.User{
+			AuthData:  model.NewPointer("abc"),
+			Email:     "fromtoken@example.com",
+			FirstName: "Token",
+			LastName:  "User",
+			Nickname:  "tok",
+		}
+
+		user, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc","email":"real@example.com","given_name":"Real"}`), tokenUser, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "real@example.com", user.Email)
+		assert.Equal(t, "Real", user.FirstName)
+		assert.Equal(t, "tok", user.Nickname)
+	})
+
+	t.Run("the email is never taken from the id token", func(t *testing.T) {
+		tokenUser := &model.User{AuthData: model.NewPointer("abc"), Email: "fromtoken@example.com"}
+
+		// The ID token is not signature verified, so a userinfo response without
+		// an email address must fail rather than borrow the address from it.
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"sub":"abc"}`), tokenUser, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "email")
+	})
+
+	t.Run("userinfo without a subject is rejected", func(t *testing.T) {
+		tokenUser := &model.User{AuthData: model.NewPointer("abc")}
+
+		_, err := provider.GetUserFromJSON(rctx, strings.NewReader(`{"email":"a@b.com"}`), tokenUser, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "sub")
+	})
+}
