+func (a *App) validateOAuthSignupInvitation(rctx request.CTX, user *model.User, inviteToken, inviteId string) (*model.Token, *model.AppError) {
+	invalidInvite := func() (*model.Token, *model.AppError) {
+		return nil, model.NewAppError("CreateOAuthUser", "api.user.create_user.signup_link_invalid.app_error", nil, "OAuth signup requires a valid email invitation", http.StatusForbidden)
+	}
+	if inviteToken == "" || inviteId != "" {
+		return invalidInvite()
+	}
+
+	token, err := a.Srv().Store().Token().GetByToken(inviteToken)
+	if err != nil || !token.IsInvitationToken() || token.IsExpired() {
+		return invalidInvite()
+	}
+	if token.Type != model.TokenTypeTeamInvitation && token.Type != model.TokenTypeGuestInvitation && token.Type != model.TokenTypeGuestMagicLinkInvitation {
+		return invalidInvite()
+	}
+	if token.Type != model.TokenTypeTeamInvitation && !*a.Config().GuestAccountsSettings.Enable {
+		return invalidInvite()
+	}
+
+	tokenData := model.MapFromJSON(strings.NewReader(token.Extra))
+	// The single-use invitation itself proves control of this email address.
+	// OIDC providers that send an explicit email_verified=false claim reject it
+	// during parsing, while some (including Entra ID) omit the optional claim.
+	if tokenData["email"] == "" || !strings.EqualFold(tokenData["email"], user.Email) || tokenData["teamId"] == "" {
+		return invalidInvite()
+	}
+
+	team, err := a.Srv().Store().Team().Get(tokenData["teamId"])
+	if err != nil || team.IsGroupConstrained() {
+		return invalidInvite()
+	}
+
+	// Guest invites must carry their restricted channel list. Do not let a
+	// malformed invitation create a guest without the intended scope.
+	if token.Type != model.TokenTypeTeamInvitation && tokenData["channels"] == "" {
+		return invalidInvite()
+	}
+
+	return token, nil
+}
