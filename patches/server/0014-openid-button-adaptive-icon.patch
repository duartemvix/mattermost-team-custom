diff --git a/webapp/channels/src/components/widgets/icons/openid_button_icon.tsx b/webapp/channels/src/components/widgets/icons/openid_button_icon.tsx
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/webapp/channels/src/components/widgets/icons/openid_button_icon.tsx
+// Copyright (c) 2026-present Mattermore contributors. All Rights Reserved.
+// See LICENSE.txt for license information.
+
+import React from 'react';
+
+import EntraIdIcon from 'components/widgets/icons/entra_id_icon';
+import LoginGoogleIcon from 'components/widgets/icons/login_google_icon';
+import LoginOpenIDIcon from 'components/widgets/icons/login_openid_icon';
+
+type Props = React.HTMLAttributes<HTMLSpanElement> & {
+    // The provider's discovery endpoint, used to pick the matching mark.
+    // Google and Entra keep their own artwork; anything else (including an
+    // identity broker in front of both) falls back to the generic OpenID mark.
+    discoveryEndpoint?: string;
+};
+
+export default function OpenIdButtonIcon(props: Props) {
+    const {discoveryEndpoint, ...rest} = props;
+    const endpoint = (discoveryEndpoint || '').toLowerCase();
+    if (endpoint.includes('accounts.google.com')) {
+        return <LoginGoogleIcon {...rest}/>;
+    }
+    if (endpoint.includes('login.microsoftonline.com') || endpoint.includes('login.windows.net') || endpoint.includes('/adfs/')) {
+        return <EntraIdIcon {...rest}/>;
+    }
+    return <LoginOpenIDIcon {...rest}/>;
+};
